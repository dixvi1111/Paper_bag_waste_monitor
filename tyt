      var reason=type==='Handle Waste'?['Handle Damage','Machine Setting Problem','Unknown'][Math.floor(rnd()*3)]:['Paper Damage','Cutting Problem','Printing Problem','Material Quality Problem','Operator Error'][Math.floor(rnd()*5)];
      var hr=sh==='Day Shift'?9+k*3:21;
      var rec=clean({id:'D'+(i*3+k+1)+'A',date:ds,time:p2(hr)+':'+p2(Math.floor(rnd()*60)),shift:sh,mission_name:missions[Math.floor(rnd()*3)],waste_type:type,gross_weight:gross,trolley_weight:tr,waste_reason:reason,notes:'',given_by:['Ravi','Anil','Sujith'][Math.floor(rnd()*3)],demo:true});
      out.push(rec);tot[sh]=Math.round((tot[sh]+rec.net_waste)*1000)/1000;
    }
    ['Day Shift','Night Shift'].forEach(function(sh,si){
      var n=2+Math.floor(rnd()*2),left=tot[sh],bad=(i%4===1&&si===1);
      for(var j=0;j<n;j++){
        var w=j===n-1?left:Math.round(left/(n-j)*100)/100;
        left=Math.round((left-w)*1000)/1000;
        if(bad&&j===n-1)w=Math.round((w+1.5)*1000)/1000;
        pn++;pal.push(cleanPallet({id:'DP'+pn+'A',date:ds,shift:sh,pallet_no:j+1,weight:w,time:sh==='Day Shift'?'15:30':'22:30',collected_by:['Sajan','Biju'][si],demo:true}));
      }
    });
  }
  return {records:out,pallets:pal};
}
function seq(list,fn,done){
  var i=0,fail=0;(function next(){if(i>=list.length)return done(fail);var x=list[i++];fn(x).then(next,function(){fail++;next()})})();
}

