/* ---------- charts ---------- */
function nice(m){if(m<=0)return 10;var e=Math.pow(10,Math.floor(Math.log10(m))),f=m/e;return (f<=1?1:f<=2?2:f<=5?5:10)*e}
function tick(v){return Number(v).toLocaleString('en-US',{maximumFractionDigits:1})}
function stacked(b,title){
  var W=640,H=260,L=46,R=10,T=18,B=36,pw=W-L-R,ph=H-T-B,n=b.length;
  var mx=nice(Math.max.apply(null,b.map(function(x){return x.a+x.b}).concat([1])));
  var s='<svg class="chart" viewBox="0 0 '+W+' '+H+'" role="img" aria-label="'+esc(title)+'">';
  for(var i=0;i<=4;i++){var y=T+ph-ph*i/4;s+='<line class="grid" x1="'+L+'" x2="'+(W-R)+'" y1="'+y+'" y2="'+y+'"/><text x="'+(L-6)+'" y="'+(y+4)+'" text-anchor="end">'+tick(mx*i/4)+'</text>'}
  var slot=pw/n,bw=Math.min(46,slot*.64),every=n>16?Math.ceil(n/12):1;
  b.forEach(function(x,i){
    var cx=L+slot*i+slot/2,ha=ph*x.a/mx,hb=ph*x.b/mx,ya=T+ph-ha,yb=ya-hb;
    s+='<g><title>'+esc(x.label)+': Paper '+n2(x.a)+' kg, Handle '+n2(x.b)+' kg</title>';
    if(x.a>0)s+='<rect class="bar" style="animation-delay:'+(i*35)+'ms" x="'+(cx-bw/2)+'" y="'+ya+'" width="'+bw+'" height="'+ha+'" rx="3" fill="var(--paper)"/>';
    if(x.b>0)s+='<rect class="bar" style="animation-delay:'+(i*35)+'ms" x="'+(cx-bw/2)+'" y="'+yb+'" width="'+bw+'" height="'+hb+'" rx="3" fill="var(--handle)"/>';
    if(n<=9&&x.a+x.b>0)s+='<text class="val" x="'+cx+'" y="'+(yb-5)+'" text-anchor="middle">'+n2(x.a+x.b)+'</text>';
    if(i%every===0)s+='<text x="'+cx+'" y="'+(H-14)+'" text-anchor="middle">'+esc(x.label)+'</text>';
    s+='</g>';
  });
  return s+'</svg><div class="legend"><span><i style="background:var(--paper)"></i>Paper Waste</span><span><i style="background:var(--handle)"></i>Handle Waste</span><span style="color:var(--muted)">KG</span></div>';
}
function hbars(items,color){
