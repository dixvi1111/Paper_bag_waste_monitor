$('#restorefile').addEventListener('change',function(ev){
  var f=ev.target.files&&ev.target.files[0];if(!f||!adm())return;
  if(f.size>8*1024*1024){toast('That file is too large to be a backup.');return}
  var fr=new FileReader();
  fr.onload=function(){
    var data;try{data=JSON.parse(fr.result)}catch(e){toast('That file is not a valid backup.');return}
    var a=Array.isArray(data)?data:(data&&data.records),pa=(data&&!Array.isArray(data)&&Array.isArray(data.pallets))?data.pallets:[];
    if(!Array.isArray(a))a=[];
    if(!a.length&&!pa.length){toast('No records found in that file.');return}
    var good=[],pg=[],bad=0;
    a.forEach(function(r){r.gross_weight=Number(r.gross_weight);r.trolley_weight=Number(r.trolley_weight);if(!r||Object.keys(validate(r)).length||!r.id)bad++;else good.push(clean(r))});
    pa.forEach(function(r){r.weight=Number(r.weight);if(!r||Object.keys(validatePallet(r)).length||!r.id)bad++;else pg.push(cleanPallet(r))});
    if(!good.length&&!pg.length){toast('No valid records in that file ('+bad+' skipped).');return}
    var clash=good.filter(function(x){return Store.records.some(function(y){return y.id===x.id})}).length+pg.filter(function(x){return Store.pallets.some(function(y){return y.id===x.id})}).length;
    PENDING={r:good,p:pg};
    openModal('<h2>Restore from this file?</h2><p style="color:var(--muted)">The file has '+good.length+' waste records and '+pg.length+' pallet records'+(bad?' ('+bad+' invalid entries will be skipped)':'')+'.</p>'
      +(clash?'<div class="note" style="border-color:var(--bad)"><b>Warning:</b> '+clash+' records already here have the same ID and will be <b>replaced</b> by the versions in the file.</div>':'<p style="color:var(--muted)">No existing record will be replaced. Nothing is deleted.</p>')
      +'<p style="color:var(--muted)">Records that are not in the file stay as they are. Download a backup first if you are not sure.</p><div class="row" style="justify-content:flex-end;margin-top:16px"><button class="btn ghost" data-act="modal-close">Cancel</button><button class="btn danger" data-act="restore-ok">Restore now</button></div>');
  };
  fr.readAsText(f);
});

