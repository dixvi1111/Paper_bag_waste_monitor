  else if(kind==='weekly'){var wd=(d.getDay()+6)%7,s=new Date(d);s.setDate(d.getDate()-wd);var e=new Date(s);e.setDate(s.getDate()+6);f=dstr(s);t=dstr(e);label=short(s)+' to '+short(e)}
  else if(kind==='monthly'){f=dstr(new Date(d.getFullYear(),d.getMonth(),1));t=dstr(new Date(d.getFullYear(),d.getMonth()+1,0));label=d.toLocaleDateString('en-GB',{month:'long',year:'numeric'})}
  else{f=d.getFullYear()+'-01-01';t=d.getFullYear()+'-12-31';label='Year '+d.getFullYear()}
