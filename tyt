function blankCfg(){return {shifts:{day:{start:'',end:''},night:{start:'',end:''}},roles:{}}}
function mergeCfg(d){
  var c=blankCfg();if(!d)return c;
  ['day','night'].forEach(function(k){var s=d.shifts&&d.shifts[k];if(s&&/^\d{2}:\d{2}$/.test(s.start||'')&&/^\d{2}:\d{2}$/.test(s.end||''))c.shifts[k]={start:s.start,end:s.end}});
  if(d.roles&&typeof d.roles==='object')Object.keys(d.roles).forEach(function(u){var v=d.roles[u];if(v==='mission'||v==='pallet'||v==='none')c.roles[u]=v});
  return c;
}
function nul(){return null}
function tmin(s){if(!/^\d{2}:\d{2}$/.test(s||''))return null;return parseInt(s.slice(0,2),10)*60+parseInt(s.slice(3),10)}
function shiftCfg(sh){return Store.cfg.shifts[sh==='Day Shift'?'day':'night']}
function shiftsSet(){var s=Store.cfg.shifts;return ['day','night'].every(function(k){return tmin(s[k].start)!=null&&tmin(s[k].end)!=null})}
function inWin(t,a,b){return a<b?(t>=a&&t<b):(t>=a||t<b)}
function suggestShift(time){
  if(!shiftsSet())return '';var t=tmin(time);if(t==null)return '';
  var d=Store.cfg.shifts.day,n=Store.cfg.shifts.night;
  if(inWin(t,tmin(d.start),tmin(d.end)))return 'Day Shift';
  if(inWin(t,tmin(n.start),tmin(n.end)))return 'Night Shift';
  return '';
}
/* the date a shift belongs to is the date it STARTED, so the after-midnight part of a night shift keeps yesterday's date */
function shiftDate(calDate,time,shift){
  if(!shiftsSet()||!shift)return calDate;
  var t=tmin(time),c=shiftCfg(shift),a=tmin(c.start),b=tmin(c.end);
  if(t==null)return calDate;
  if(a>b&&t<b){var d=parseD(calDate);d.setDate(d.getDate()-1);return dstr(d)}
  return calDate;
}
function shiftWindow(date,shift){
  if(!shiftsSet())return null;
  var c=shiftCfg(shift),a=tmin(c.start),b=tmin(c.end),d=parseD(date);
  var s=new Date(d.getFullYear(),d.getMonth(),d.getDate(),0,a),e=new Date(d.getFullYear(),d.getMonth(),d.getDate(),0,b);
  if(b<=a)e.setDate(e.getDate()+1);
  return {start:s,end:e};
}
function shiftStatus(date,shift){
  var w=shiftWindow(date,shift);if(!w)return {k:'unset',t:'Shift times not set'};
  var n=new Date();if(n>=w.end)return {k:'done',t:'Completed'};if(n<w.start)return {k:'wait',t:'Not started'};return {k:'live',t:'In progress'};
}
function autoObj(o){
  if(!o.shiftTouched){var s=suggestShift(o.time);if(s)o.shift=s}
  if(!o.dateTouched)o.date=shiftDate(today(),o.time,o.shift||'');
}
