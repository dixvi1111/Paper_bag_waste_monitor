/* ---------- validation (also used on restore) ---------- */
function validate(r){
  var e={};
  if(!/^\d{4}-\d{2}-\d{2}$/.test(r.date||''))e.date='Choose a date.';
  if(!/^\d{2}:\d{2}$/.test(r.time||''))e.time='Choose a time.';
  if(!String(r.mission_name||'').trim())e.mission_name='Mission name is required, for example 5 QT.';
  if(TYPES.indexOf(r.waste_type)<0)e.waste_type='Choose Paper Waste or Handle Waste.';
  var g=r.gross_weight,t=r.trolley_weight;
  if(!isFinite(g)||g<=0)e.gross_weight='Enter the gross weight in KG, more than 0.';
  if(!isFinite(t)||t<0)e.trolley_weight='Enter the empty trolley weight in KG, 0 or more.';
  if(!e.gross_weight&&!e.trolley_weight&&g<t)e.gross_weight='Gross weight cannot be less than the trolley weight.';
  if(REASONS.indexOf(r.waste_reason)<0)e.waste_reason='Choose a waste reason.';
  if(r.shift&&SHIFTS.indexOf(r.shift)<0)e.shift='Choose Day Shift or Night Shift.';
  return e;
}
function net(g,t){return Math.round((g-t)*1000)/1000}
function clean(r){
  var g=Number(r.gross_weight),t=Number(r.trolley_weight);
  var o={id:String(r.id||uid()),date:r.date,time:r.time,mission_name:String(r.mission_name).trim().slice(0,60),waste_type:r.waste_type,
    gross_weight:g,trolley_weight:t,net_waste:net(g,t),waste_reason:r.waste_reason,notes:String(r.notes||'').slice(0,500)};
  if(r.shift)o.shift=r.shift;
  if(r.given_by)o.given_by=String(r.given_by).trim().slice(0,60);
  if(r.demo)o.demo=true;
  return o;
}
function validatePallet(r){
  var e={};
