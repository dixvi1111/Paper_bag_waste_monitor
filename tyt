/* ---------- store: shared database when available, otherwise this device ---------- */
var Store={mode:'local',records:[],pallets:[],cfg:blankCfg(),ready:false,roleReady:false,slow:false,subs:[],chain:Promise.resolve(),cols:{},cfgRef:null,me:{id:null},role:{admin:true,write:true,key:'admin'},
  on:function(f){this.subs.push(f)},
  emit:function(){for(var i=0;i<this.subs.length;i++)this.subs[i]()},
  setList:function(kind,a){a.sort(function(x,y){return (y.date+(y.time||'')).localeCompare(x.date+(x.time||''))});this[kind]=a;this.ready=true;this.emit()},
  loadLocal:function(){
    var self=this;
    ['records','pallets'].forEach(function(k){var a=[];try{a=JSON.parse(localStorage.getItem('pbwm_'+k)||'[]')}catch(e){}self.setList(k,Array.isArray(a)?a:[])});
    var c=null;try{c=JSON.parse(localStorage.getItem('pbwm_cfg')||'null')}catch(e){}
    this.cfg=mergeCfg(c);
  },
  saveLocal:function(kind){try{localStorage.setItem('pbwm_'+kind,JSON.stringify(this[kind]))}catch(e){}},
  resolveRole:function(){
    if(this.role.admin){this.role.key='admin';return}
    var k=this.cfg.roles[this.me.id];this.role.key=(k==='mission'||k==='pallet')?k:'none';
  },
  init:function(){
    var self=this;
    var go=function(){self.mode='local';self.role={admin:true,write:true,key:'admin'};self.loadLocal();self.roleReady=true;self.emit()};
    if(!(window.claude&&claude.use)){go();return Promise.resolve()}
    return Promise.all([claude.use('db').catch(nul),claude.use('user').catch(nul)]).then(function(res){
      var db=res[0],user=res[1];
      if(!db){go();return}
      return Promise.all([user&&user.canEdit?user.canEdit():false,user&&user.can?user.can('data.write'):null,user&&user.id?user.id():null]).then(function(p){
        var admin=p[0]===true;self.me.id=p[2];
        self.role={admin:admin,write:p[1]!==false,key:admin?'admin':'none'};
        self.mode='cloud';
        self.cols.records=db.collection('records');self.cols.pallets=db.collection('pallets');self.cfgRef=db.doc('settings/config');
        var timer=setTimeout(function(){self.slow=true;self.emit()},10000);
        var sub=function(kind){self.cols[kind].onSnapshot(function(snap){
          if(!snap.metadata.fromCache){clearTimeout(timer);self.slow=false}
          self.setList(kind,snap.docs.map(function(d){var o=Object.assign({},d.data());o.id=d.id;return o}));
        },function(){clearTimeout(timer);self.slow=true;self.emit()})};
        sub('records');sub('pallets');
        self.cfgRef.onSnapshot(function(s){self.cfg=mergeCfg(s.exists?s.data():null);self.resolveRole();self.roleReady=true;self.emit()},function(){self.roleReady=true;self.emit()});
        setTimeout(function(){if(!self.roleReady){self.roleReady=true;self.emit()}},8000);
      });
    }).catch(go);
  },
  put:function(rec,isNew,kind){
    kind=kind||'records';var pre=kind==='pallets'?'P':'';var self=this;
    var write=function(){
      if(self.mode==='cloud')return self.cols[kind].doc(rec.id).set(rec).then(function(){return rec});
      var arr=self[kind],i=arr.findIndex(function(x){return x.id===rec.id});
      if(i>=0)arr[i]=rec;else arr.push(rec);
      self.setList(kind,arr.slice());self.saveLocal(kind);return Promise.resolve(rec);
    };
    var job=function(){
      if(!isNew)return write();
      // new records get the next number followed by A: 1A, 2A, 3A (pallets: P1A, P2A ...)
      var re=new RegExp('^'+pre+'(\\d+)A$'),mx=0;
      self[kind].forEach(function(x){var m=re.exec(x.id);if(m)mx=Math.max(mx,parseInt(m[1],10))});
      var n=mx+1;
      var pick=function(){rec.id=pre+n+'A';if(self.mode!=='cloud')return Promise.resolve();return self.cols[kind].doc(rec.id).get().then(function(s){if(s.exists){n++;return pick()}})};
      return pick().then(write);
    };
    this.chain=this.chain.then(job,job);return this.chain;
  },
  del:function(id,kind){
    kind=kind||'records';var self=this;
    var job=function(){
      if(self.mode==='cloud')return self.cols[kind].doc(id).delete();
      self.setList(kind,self[kind].filter(function(x){return x.id!==id}));self.saveLocal(kind);return Promise.resolve();
    };
    this.chain=this.chain.then(job,job);return this.chain;
  },
  saveCfg:function(){
    var self=this;
    var job=function(){
      if(self.mode==='cloud')return self.cfgRef.set(self.cfg);
      try{localStorage.setItem('pbwm_cfg',JSON.stringify(self.cfg))}catch(e){}
      self.emit();return Promise.resolve();
    };
    this.chain=this.chain.then(job,job);return this.chain;
  }
};

