<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0b1538"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Waste Monitor"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><style>html,body{margin:0;background:#0b1538}</style></head><body><title>Paper Bag Waste Monitor</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
<style>
/* Layout: glass sidebar and deep-blue gradient work area on desktop; bottom tab bar on phones. Depth comes from glass cards, glossy 3D blue shapes and a gentle pointer tilt. */
:root{
  color-scheme:dark;
  --navy:#0a1432; --navy-2:rgba(255,255,255,.1); --navy-ink:#b4c3e6; --navy-line:rgba(255,255,255,.1);
  --bg:#0a1330; --surface:rgba(255,255,255,.07); --surface-2:rgba(255,255,255,.055); --surface-3:rgba(255,255,255,.17); --solid:#14234f;
  --ink:#f3f6ff; --muted:#a9b8da; --line:rgba(255,255,255,.14);
  --blue:#6f9bff; --blue-ink:#071433; --blue-soft:rgba(111,155,255,.2);
  --btn:#ffffff; --btn-ink:#0b1a45;
  --paper:#6fa0ff; --handle:#ffa95c;
  --good:#5fdc92; --good-bg:rgba(60,200,120,.16); --warn:#ffc266; --warn-bg:rgba(255,180,60,.15); --bad:#ff8c8c; --bad-bg:rgba(255,90,90,.16);
  --shadow:0 1px 0 rgba(255,255,255,.1) inset,0 18px 40px -16px rgba(0,0,0,.55);
  --shadow-hover:0 1px 0 rgba(255,255,255,.14) inset,0 28px 54px -18px rgba(0,0,0,.65),0 0 0 1px rgba(140,170,255,.28);
  --font:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif; --head:'Manrope','Inter',system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--font);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--head);margin:0;letter-spacing:-.01em;text-wrap:balance}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px;border-radius:6px}
.num{font-variant-numeric:tabular-nums}

/* shell */
.app{min-height:100vh;display:grid;grid-template-columns:1fr;background:radial-gradient(60% 40% at 78% 0%,rgba(80,120,230,.40),transparent 70%),radial-gradient(50% 40% at 0% 100%,rgba(60,90,200,.28),transparent 70%)}
.side{display:none}
main{min-width:0;padding-block:16px 96px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.top h1{font-size:clamp(22px,5vw,30px)}
.top .sub{color:var(--muted);font-size:13px}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:5px 11px;font-size:12px;font-weight:600;background:var(--surface-2);border:1px solid var(--line);color:var(--muted)}
.chip.good{background:var(--good-bg);color:var(--good);border-color:transparent}
.chip.warn{background:var(--warn-bg);color:var(--warn);border-color:transparent}
.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;overflow-x:auto;gap:2px;background:var(--navy);padding:6px max(6px,env(safe-area-inset-right,0px)) calc(6px + env(safe-area-inset-bottom,0px)) max(6px,env(safe-area-inset-left,0px));box-shadow:0 -8px 24px rgba(0,0,0,.25)}
.tabbar a{flex:1 0 66px;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;color:var(--navy-ink);font-size:11px;font-weight:500;text-decoration:none;border-radius:10px}
.tabbar a svg,.side a svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.tabbar a[aria-current="page"]{color:#fff;background:var(--navy-2)}
@media(min-width:900px){
  .app{grid-template-columns:252px 1fr}
  .side{display:flex;flex-direction:column;gap:6px;position:sticky;top:0;height:100vh;background:linear-gradient(180deg,rgba(16,30,76,.78),rgba(7,13,34,.92));border-right:1px solid var(--line);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:var(--navy-ink);padding:22px 14px}
  .brand{display:flex;gap:10px;align-items:center;padding:4px 8px 18px;color:#fff;font:700 17px/1.15 var(--head)}
  .brand small{display:block;font:500 11px var(--font);color:var(--navy-ink);letter-spacing:.04em;margin-top:3px}
  .side a{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:12px;color:var(--navy-ink);text-decoration:none;font-weight:500;transition:background .2s,color .2s,transform .2s}
  .side a:hover{background:var(--navy-2);color:#fff;transform:translateX(3px)}
  .side a[aria-current="page"]{background:linear-gradient(135deg,#5b8cff,#3156d8);color:#fff;box-shadow:0 10px 22px -8px rgba(91,140,255,.75)}
  .side .foot{margin-top:auto;border-top:1px solid var(--navy-line);padding:14px 8px 0;font-size:12px;line-height:1.5}
  .tabbar{display:none}
  main{padding-block:26px 40px;padding-left:max(28px,env(safe-area-inset-left,0px));padding-right:max(28px,env(safe-area-inset-right,0px))}
}

/* cards and 3D */
.stage{perspective:1000px}
.card{background:linear-gradient(160deg,rgba(255,255,255,.10),rgba(255,255,255,.04));border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:18px;min-width:0;transition:box-shadow .25s,transform .25s}
.tilt{transform-style:preserve-3d;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));will-change:transform}
.tilt:hover{box-shadow:var(--shadow-hover)}
.card h2{font-size:17px;margin-bottom:4px}
.card .hint{color:var(--muted);font-size:13px;margin:0 0 14px}
.grid{display:grid;gap:16px;min-width:0}
.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
@media(min-width:1100px){.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}}
.kpi{position:relative;overflow:hidden;padding:16px}
.kpi::before{content:"";position:absolute;right:-26px;top:-26px;width:90px;height:90px;border-radius:50%;background:var(--kc,var(--blue));opacity:.13}
.kpi .l{font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.kpi .v{font:700 clamp(26px,5.4vw,36px)/1.1 var(--head);margin-top:8px}
.kpi .v small{font-size:14px;font-weight:600;color:var(--muted);margin-left:4px}
.kpi .s{font-size:12px;color:var(--muted);margin-top:4px}
.two{grid-template-columns:1fr}
@media(min-width:1100px){.two{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)}.two.even{grid-template-columns:repeat(2,minmax(0,1fr))}}
.banner{position:relative;border-radius:26px;overflow:hidden;min-height:150px;display:flex;align-items:center;margin-bottom:16px;border:1px solid var(--line);background:radial-gradient(80% 140% at 88% 0%,rgba(111,155,255,.5),transparent 62%),linear-gradient(120deg,#1c3274,#0e1a46 72%);box-shadow:var(--shadow)}
.banner .in{position:relative;z-index:1;padding:22px;max-width:min(62%,560px)}
.banner.big{min-height:260px}
.banner h2{font-size:clamp(22px,5vw,30px);line-height:1.1;font-weight:800}
.banner.big h2{font-size:clamp(34px,8.5vw,68px);line-height:1.02}
.banner p{margin:10px 0 0;color:#c3d0ee;font-size:14px;max-width:44ch}
.banner .scene{position:absolute;right:1%;bottom:-6%;width:clamp(130px,38%,380px);height:auto;max-width:none;pointer-events:none;animation:sway 6s ease-in-out infinite}
.banner.big .scene{width:clamp(150px,46%,470px)}
@keyframes sway{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.note{border-radius:12px;padding:10px 14px;font-size:13px;margin-bottom:14px;background:var(--warn-bg);color:var(--warn)}
.note.good{background:var(--good-bg);color:var(--good)}

/* buttons, forms */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:99px;padding:11px 20px;font-weight:700;cursor:pointer;background:var(--btn);color:var(--btn-ink);box-shadow:0 10px 24px -10px rgba(140,170,255,.8);transition:transform .15s,filter .15s;text-decoration:none;min-height:44px}
.btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.btn:active{transform:translateY(0)}
.btn.ghost{background:var(--surface-2);color:var(--ink);border:1px solid var(--line);box-shadow:none}
.btn.danger{background:#e5484d;color:#fff;box-shadow:none}
.btn.sm{padding:7px 14px;min-height:36px;font-size:13px}
.btn[disabled]{opacity:.5;cursor:not-allowed;transform:none}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
form .fields{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:640px){form .fields{grid-template-columns:1fr 1fr}.span2{grid-column:1/-1}}
label.f{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;min-width:0}
.in-el{width:100%;min-height:46px;padding:10px 12px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface-2);font-size:16px;font-weight:500}
textarea.in-el{min-height:84px;resize:vertical}
.in-el:focus{border-color:var(--blue);background:var(--surface-3)}
select.in-el option{background:#10204f;color:#fff}
.err{color:var(--bad);font-size:12.5px;font-weight:500;min-height:0}
.in-el[aria-invalid="true"]{border-color:var(--bad)}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.seg label{position:relative;cursor:pointer}
.seg input{position:absolute;opacity:0;inset:0}
.seg span{display:flex;align-items:center;gap:10px;padding:12px;border:1.5px solid var(--line);border-radius:12px;background:var(--surface-2);font-weight:600;min-height:46px}
.seg i{width:12px;height:12px;border-radius:4px;background:var(--c)}
.seg input:checked+span{border-color:var(--blue);background:var(--blue-soft)}
.seg input:focus-visible+span{outline:3px solid var(--blue);outline-offset:2px}
.net{border-radius:16px;padding:16px;background:var(--surface-2);border:1.5px dashed var(--line);text-align:center}
.net .v{font:700 40px/1.1 var(--head)}
.net.ok{background:var(--good-bg);border-color:transparent;color:var(--good)}
.net.bad{background:var(--bad-bg);border-color:transparent;color:var(--bad)}
.net .t{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;opacity:.85}
.roll{width:150px;height:140px;margin:0 auto;display:block;animation:bob 4s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0) rotateY(-8deg)}50%{transform:translateY(-6px) rotateY(8deg)}}

/* tables, pills */
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:14px}
table{border-collapse:collapse;width:100%;font-size:14px;min-width:560px}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--surface-2);position:sticky;top:0}
tr:last-child td{border-bottom:0}
td.r,th.r{text-align:right}
td.wrap{white-space:normal;min-width:140px}
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:2px 10px;font-size:12px;font-weight:600;background:var(--surface-2);border:1px solid var(--line)}
.pill i{width:8px;height:8px;border-radius:3px;background:var(--c)}
.demo{font-size:10px;font-weight:700;letter-spacing:.08em;color:var(--warn);background:var(--warn-bg);border-radius:6px;padding:1px 5px;margin-left:6px}
.empty{text-align:center;padding:28px 12px;color:var(--muted)}
.empty b{display:block;color:var(--ink);font:600 17px var(--head);margin-bottom:6px}

/* charts */
.chart{width:100%;height:auto;display:block}
.chart text{fill:var(--muted);font:11px var(--font)}
.chart .val{fill:var(--ink);font-weight:600}
.chart .grid{stroke:var(--line)}
.bar{transform-box:fill-box;transform-origin:bottom;animation:grow .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;margin-top:8px}
.legend i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.hb{display:grid;grid-template-columns:minmax(80px,32%) 1fr auto;gap:10px;align-items:center;font-size:13.5px;padding:5px 0}
.hb .lbl{overflow-wrap:anywhere}
.hb .track{height:12px;border-radius:99px;background:var(--surface-2);overflow:hidden}
.hb .track i{display:block;height:100%;border-radius:99px;background:var(--blue);animation:fill .8s cubic-bezier(.2,.8,.2,1) both;transform-origin:left}
@keyframes fill{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.donutwrap{display:flex;gap:18px;align-items:center;flex-wrap:wrap;justify-content:center}
.donut{width:170px;height:170px;flex:none}
.donut circle{transition:stroke-dasharray .8s}
.donut text{fill:var(--ink);font:700 18px var(--head);text-anchor:middle}
.donut .s{fill:var(--muted);font:500 10px var(--font)}
.lg div{display:flex;gap:8px;align-items:baseline;margin:4px 0;font-size:14px}
.lg i{width:11px;height:11px;border-radius:3px;display:inline-block;flex:none;transform:translateY(1px)}
details.dt{margin-top:12px}
details.dt summary{cursor:pointer;font-weight:600;font-size:13px;color:var(--blue);min-height:32px}

/* tabs, filters, modal, toast */
.tabs{display:flex;gap:6px;flex-wrap:wrap;background:var(--surface-2);padding:5px;border-radius:14px;border:1px solid var(--line)}
.tabs button{border:0;background:none;padding:9px 16px;border-radius:10px;font-weight:600;cursor:pointer;color:var(--muted);min-height:40px}
.tabs button[aria-pressed="true"]{background:var(--surface-3);color:var(--ink)}
.filters{display:grid;gap:10px;grid-template-columns:1fr 1fr;margin-bottom:12px}
@media(min-width:900px){.filters{grid-template-columns:2fr 1fr 1fr 1fr 1fr}}
.filters .wide{grid-column:1/-1}
@media(min-width:900px){.filters .wide{grid-column:auto}}
.modal{position:fixed;inset:0;z-index:100;display:grid;place-items:center;background:rgba(6,12,28,.6);padding:16px}
.modal .box{background:var(--solid);border:1px solid var(--line);border-radius:18px;padding:22px;max-width:420px;width:100%;box-shadow:var(--shadow-hover)}
.toast{position:fixed;left:50%;bottom:calc(86px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;background:var(--navy);color:#fff;padding:12px 18px;border-radius:14px;font-weight:500;z-index:120;max-width:calc(100vw - 32px);transition:.3s;box-shadow:0 14px 30px rgba(0,0,0,.35)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media(min-width:900px){.toast{bottom:28px}}
.sn{display:flex;flex-direction:column;gap:6px}
.fhero{position:relative;border-radius:26px;overflow:hidden;margin-bottom:16px;border:1px solid var(--line);background:linear-gradient(180deg,#1c3274,#0c1740);box-shadow:var(--shadow)}
.fhead{position:relative;z-index:2;padding:20px 20px 0}
.fhead h2{font-size:clamp(26px,6vw,46px);line-height:1.05;font-weight:800;color:#fff}
.fhead p{margin:6px 0 0;color:#c3d0ee;font-size:14px}
.roles{position:relative;z-index:2;display:grid;grid-template-columns:1fr;gap:10px;padding:14px 16px 4px}
@media(min-width:760px){.roles{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}}
.rc{display:block;text-align:left;font:inherit;color:#0b1538;border:0;border-radius:18px;padding:12px 14px;cursor:pointer;text-decoration:none;background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(225,234,255,.92));box-shadow:0 18px 30px -14px rgba(0,0,0,.55),inset 0 1px 0 #fff;animation:bob 7s ease-in-out infinite}
.rc:nth-child(2){animation-delay:-2s}.rc:nth-child(3){animation-delay:-4s}
.rc .rh{display:block;margin:-12px -14px 8px;padding:9px 14px;border-radius:18px 18px 0 0;color:#fff;font:800 17px var(--head)}
.rc.admin .rh{background:linear-gradient(135deg,#22c55e,#15803d)}.rc.mission .rh{background:linear-gradient(135deg,#3b82f6,#1d4ed8)}.rc.pallet .rh{background:linear-gradient(135deg,#8b5cf6,#6d28d9)}
.rc ul{list-style:none;margin:0;padding:0;font-size:13.5px;line-height:1.7;font-weight:600}
.rc li::before{content:"\2713";margin-right:8px;font-weight:800}
.rc.admin li::before{color:#16a34a}.rc.mission li::before{color:#2563eb}.rc.pallet li::before{color:#7c3aed}
.rc .rgo{display:inline-block;margin-top:6px;font-size:12px;font-weight:700;color:#3156d8}
.fscene{display:block;width:100%;height:auto;margin-top:-6px}
.tiles{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}
@media(min-width:1000px){.tiles{grid-template-columns:repeat(4,minmax(0,1fr))}}
.tile{border-radius:20px;padding:16px;color:#fff;box-shadow:0 20px 34px -16px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.35)}
.tile .tl{font:700 13px var(--head);letter-spacing:.04em;opacity:.95}
.tile .tv{font:800 clamp(24px,5.4vw,34px)/1.1 var(--head);margin-top:10px}
.tile .tv small{font-size:14px;margin-left:5px;font-weight:700;opacity:.9}
.t-blue{background:linear-gradient(145deg,#4f8dff,#1d4ed8)}.t-green{background:linear-gradient(145deg,#2fd07a,#15803d)}.t-orange{background:linear-gradient(145deg,#ffa23a,#e2630f)}.t-purple{background:linear-gradient(145deg,#9b6dff,#5b21b6)}
.lite .fscene{display:none}.lite .rc,.lite .tile,.lite .scene,.lite .roll{animation:none!important}.lite .tilt{transform:none!important}.lite *{animation-duration:.01ms!important}

.chk{display:grid;gap:16px;grid-template-columns:1fr;margin-top:16px}
@media(min-width:1000px){.chk{grid-template-columns:repeat(3,minmax(0,1fr))}}
.stat{display:grid;grid-template-columns:1fr auto;gap:8px 12px;font-size:14px;margin-top:12px}
.stat span{color:var(--muted)}
.verdict{display:inline-flex;align-items:center;gap:8px;border-radius:99px;padding:7px 16px;font:800 15px var(--head);letter-spacing:.07em}
.verdict.match{background:var(--good-bg);color:var(--good)}
.verdict.mismatch{background:var(--bad-bg);color:var(--bad)}
.verdict.none{background:var(--surface-2);color:var(--muted)}
.prow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface-2);margin-top:8px}
.who{color:var(--muted);font-size:12px}
.enter{animation:enter .35s cubic-bezier(.2,.8,.2,1) both}
@keyframes enter{from{opacity:0;transform:translateY(14px) scale(.99)}to{opacity:1;transform:none}}
.ok-panel{display:flex;gap:14px;align-items:flex-start;background:var(--good-bg);color:var(--good);border-radius:14px;padding:14px;margin-bottom:14px}
.ok-panel b{display:block;font-family:var(--head);font-size:16px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.tilt{transform:none!important}}
</style>

