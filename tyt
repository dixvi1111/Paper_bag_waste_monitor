/* ---------- shift verification ---------- */
function sumShift(date,shift){
  var m=Store.records.filter(function(r){return r.date===date&&r.shift===shift});
  var p=Store.pallets.filter(function(r){return r.date===date&&r.shift===shift});
  var names={};m.forEach(function(r){names[String(r.mission_name).trim().toLowerCase()]=1});
  var mt=sum(m,'net_waste'),pt=sum(p,'weight');
  return {m:m,p:p,missions:Object.keys(names).length,mt:mt,pt:pt,diff:Math.round((mt-pt)*1000)/1000};
}
function verdict(s){
  if(!s.m.length&&!s.p.length)return {k:'none',t:'NO RECORDS'};
  return s.diff===0?{k:'match',t:'MATCH'}:{k:'mismatch',t:'MISMATCH'};
}
function combine(a,b){
  var names={};a.m.concat(b.m).forEach(function(r){names[String(r.mission_name).trim().toLowerCase()]=1});
  var mt=Math.round((a.mt+b.mt)*1000)/1000,pt=Math.round((a.pt+b.pt)*1000)/1000;
  return {m:a.m.concat(b.m),p:a.p.concat(b.p),missions:Object.keys(names).length,mt:mt,pt:pt,diff:Math.round((mt-pt)*1000)/1000};
}
