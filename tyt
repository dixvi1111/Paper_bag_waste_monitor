  if(!/^\d{2}:\d{2}$/.test(r.time||''))e.time='Choose a time.';
  if(SHIFTS.indexOf(r.shift)<0)e.shift='Choose Day Shift or Night Shift.';
  if(!isFinite(r.weight)||r.weight<=0)e.weight='Enter the pallet weight in KG, more than 0.';
