    <div class="brand"><svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect x="5" y="9" width="24" height="21" rx="3" fill="#c9965a"/><path d="M5 9l3-5h18l3 5z" fill="#e2b47a"/><path d="M12 9c0-5 10-5 10 0" fill="none" stroke="#fff" stroke-width="2"/></svg><div>Paper Bag<br>Waste Monitor<small>PAPER BAG DEPARTMENT</small></div></div>
